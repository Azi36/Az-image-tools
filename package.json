{
  "name": "az-im",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "prepare:codecs": "node scripts/prepare-codecs.mjs",
    "predev": "npm run prepare:codecs",
    "dev": "next dev",
    "prebuild": "npm run prepare:codecs",
    "build": "next build",
    "build:pages": "npm run prepare:codecs && next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint src tests --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --no-error-on-unmatched-pattern --ignore-unknown src/**/*",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "@squoosh-kit/avif": "^0.2.4",
    "@squoosh-kit/imagequant": "^0.2.4",
    "@squoosh-kit/mozjpeg": "0.2.4",
    "@squoosh-kit/oxipng": "^0.2.4",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "classnames": "^2.5.1",
    "filesize": "^10.1.1",
    "heic-to": "^1.5.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "next": "^16.3.1",
    "onnxruntime-web": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-responsive": "^10.0.1",
    "sprintf-js": "^1.1.3",
    "svgo": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sprintf-js": "^1.1.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
